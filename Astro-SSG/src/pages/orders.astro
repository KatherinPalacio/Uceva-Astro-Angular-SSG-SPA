---
import MainLayout from "@layouts/MainLayout.astro";

const orders = [
  { id: 1, customer: 'Juan Pérez', total: 120000, status: 'Completado' },
  { id: 2, customer: 'María López', total: 85000, status: 'Pendiente' },
  { id: 3, customer: 'Carlos Gómez', total: 45000, status: 'Cancelado' },
  { id: 4, customer: 'Ana Torres', total: 99000, status: 'Completado' },
];
---

<MainLayout>
  <h1>Pedidos</h1>
  <hr />

  <table class="table table-striped border">
    <thead>
      <tr>
        <th>ID</th>
        <th>Cliente</th>
        <th>Total</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      {orders.map((order) => (
        <tr>
          <td>{order.id}</td>
          <td>{order.customer}</td>
          <td>${order.total}</td>
          <td>{order.status}</td>
        </tr>
      ))}
    </tbody>
  </table>
</MainLayout>